{
  "expo": {
    "name": "Calculator",
    "slug": "calculator",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#1e2329"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.calculator",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Calculator to use location for local calculations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e2329"
      },
      "package": "com.anonymous.calculator",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Calculator to access your location."
        }
      ]
    ]
  }
}
